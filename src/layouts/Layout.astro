---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import VendorEmbeds from "../components/VendorEmbeds.astro";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Bright Path Tutoring — Personalized Online Tutoring",
	description = "One-on-one and small-group tutoring in reading, math, and test prep. Book a free session and get a personalized learning plan.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
		<VendorEmbeds />
	</body>
</html>
