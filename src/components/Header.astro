---
const navLinks = [
	{ href: "#programs", label: "Programs" },
	{ href: "#how-it-works", label: "How It Works" },
	{ href: "#reviews", label: "Reviews" },
	{ href: "#contact", label: "Contact" },
];
---

<header class="site-header">
	<div class="container site-header__inner">
		<a href="/" class="logo">Bright Path Tutoring</a>

		<nav class="nav" aria-label="Primary">
			<ul>
				{
					navLinks.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))
				}
			</ul>
		</nav>

		<a href="#contact" class="btn btn-primary btn-header-cta">Book a Free Session</a>
	</div>
</header>

<style>
	.site-header {
		border-bottom: 1px solid var(--color-border);
		background: var(--color-bg);
		position: sticky;
		top: 0;
		z-index: 20;
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		height: 72px;
	}

	.logo {
		font-weight: 700;
		font-size: 1.05rem;
		text-decoration: none;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}

	.nav ul {
		display: flex;
		gap: var(--space-3);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.nav a {
		text-decoration: none;
		font-size: 0.9rem;
		color: var(--color-ink-muted);
	}

	.nav a:hover {
		color: var(--color-ink);
	}

	.btn-header-cta {
		padding: 0.6rem 1.1rem;
		font-size: 0.85rem;
		white-space: nowrap;
	}

	@media (max-width: 760px) {
		.nav {
			display: none;
		}
	}
</style>
