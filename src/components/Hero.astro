<section class="hero">
	<div class="container hero__inner">
		<span class="eyebrow">Online Tutoring</span>
		<h1>Personalized tutoring that meets students where they are.</h1>
		<p class="hero__lede">
			One-on-one and small-group sessions in reading, math, and test prep
			&mdash; online, on your schedule. Matched with a tutor in under 48 hours.
		</p>
		<div class="btn-row">
			<a href="#contact" class="btn btn-primary">Book a Free Session</a>
			<a href="#how-it-works" class="btn btn-outline">See How It Works</a>
		</div>
	</div>
</section>

<style>
	.hero {
		padding: var(--space-6) 0;
		border-bottom: 1px solid var(--color-border);
	}

	.hero__inner {
		max-width: 720px;
	}

	.hero__lede {
		font-size: 1.1rem;
		max-width: 560px;
	}

	@media (max-width: 600px) {
		.hero {
			padding: var(--space-5) 0;
		}
	}
</style>
