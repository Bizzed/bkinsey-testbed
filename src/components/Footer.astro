---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container site-footer__grid">
		<div class="site-footer__brand">
			<p class="logo">Bright Path Tutoring</p>
			<p>Personalized online tutoring for reading, math, and test prep.</p>
		</div>

		<div>
			<h4>Programs</h4>
			<ul>
				<li><a href="#programs">1-on-1 Tutoring</a></li>
				<li><a href="#programs">Small Group Sessions</a></li>
				<li><a href="#programs">Test Prep</a></li>
				<li><a href="#programs">Homework Help</a></li>
			</ul>
		</div>

		<div>
			<h4>Company</h4>
			<ul>
				<li><a href="#how-it-works">How It Works</a></li>
				<li><a href="#reviews">Reviews</a></li>
				<li><a href="#contact">Contact</a></li>
			</ul>
		</div>

		<div>
			<h4>Contact</h4>
			<ul>
				<li><a href="mailto:hello@brightpathtutoring.test">hello@brightpathtutoring.test</a></li>
				<li><a href="tel:+15555550142">(555) 555-0142</a></li>
			</ul>
		</div>
	</div>

	<div class="container site-footer__bottom">
		<p>&copy; {year} Bright Path Tutoring. All rights reserved.</p>
		<p class="sandbox-note">Internal sandbox environment &mdash; Bizzed testbed for third-party integration testing.</p>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--color-border);
		background: var(--color-bg-alt);
		padding-top: var(--space-5);
	}

	.site-footer__grid {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr 1fr;
		gap: var(--space-4);
		padding-bottom: var(--space-4);
	}

	.site-footer__brand .logo {
		font-weight: 700;
		margin-bottom: var(--space-1);
	}

	.site-footer h4 {
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		margin-bottom: var(--space-2);
	}

	.site-footer ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.site-footer a {
		text-decoration: none;
		color: var(--color-ink-muted);
		font-size: 0.9rem;
	}

	.site-footer a:hover {
		color: var(--color-ink);
	}

	.site-footer__bottom {
		border-top: 1px solid var(--color-border);
		padding: var(--space-3) 0;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--space-1);
	}

	.site-footer__bottom p {
		margin: 0;
		font-size: 0.8rem;
	}

	.sandbox-note {
		color: var(--color-ink-muted);
		opacity: 0.75;
	}

	@media (max-width: 760px) {
		.site-footer__grid {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
